{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: release",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "steelseries-sonar-tray.sln",
        "-c",
        "Release"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build: debug",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "build",
        "steelseries-sonar-tray/steelseries-sonar-tray.csproj",
        "-c",
        "Debug"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "steelseries-sonar-tray/steelseries-sonar-tray.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      // Приложение живёт в трее и не завершается по закрытию окон — перед
      // повторной отладкой старый экземпляр нужно остановить.
      "label": "app: stop running instance",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-Command",
        "Get-Process SonarQuickMixer -ErrorAction SilentlyContinue | Stop-Process -Force"
      ],
      "problemMatcher": []
    },
    {
      "label": "publish: dist",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "publish",
        "steelseries-sonar-tray/steelseries-sonar-tray.csproj",
        "-p:PublishProfile=Folder"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish: single exe",
      "type": "shell",
      "command": "dotnet",
      "args": [
        "publish",
        "steelseries-sonar-tray/steelseries-sonar-tray.csproj",
        "-p:PublishProfile=SingleFile"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    }
  ]
}
