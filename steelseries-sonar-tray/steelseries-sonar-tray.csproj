<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>SonarQuickMixer</RootNamespace>
    <AssemblyName>SonarQuickMixer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <AssemblyTitle>Sonar Quick Mixer</AssemblyTitle>
    <Product>Sonar Quick Mixer</Product>
    <Description>Lightweight Windows system-tray companion for SteelSeries Sonar.</Description>
    <Company>Lixetron</Company>
    <Copyright>Copyright © 2026 Lixetron</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SonarQuickMixer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Melanchall.DryWetMidi" Version="8.0.3" />
    <PackageReference Include="NAudio" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\app-icon.png" />
    <Content Include="Assets\tray-accent.png" />
    <Content Include="Assets\tray-white.png" />
    <Content Include="Assets\tray-dark.png" />
    <Content Include="Assets\app.ico" />
    <Content Include="Presets\**\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <!-- Keep beside the published host so release zips include Presets\ next to SonarQuickMixer.exe. -->
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <EmbeddedResource Include="Assets\tray-accent.ico">
      <LogicalName>tray-accent.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\tray-white.ico">
      <LogicalName>tray-white.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\tray-dark.ico">
      <LogicalName>tray-dark.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- DryWetMidi's NuGet targets always CopyToOutput the macOS .dylib; drop it on Windows publishes. -->
  <Target Name="StripDryWetMidiMacNative"
          AfterTargets="ResolveReferences;PrepareForBuild"
          BeforeTargets="AssignTargetPaths;ComputeFilesToPublish">
    <ItemGroup>
      <None Remove="@(None)"
            Condition="'%(Filename)%(Extension)' == 'Melanchall_DryWetMidi_Native64.dylib'" />
      <ContentWithTargetPath Remove="@(ContentWithTargetPath)"
            Condition="'%(Filename)%(Extension)' == 'Melanchall_DryWetMidi_Native64.dylib'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
            Condition="'%(Filename)%(Extension)' == 'Melanchall_DryWetMidi_Native64.dylib'" />
    </ItemGroup>
  </Target>

</Project>
