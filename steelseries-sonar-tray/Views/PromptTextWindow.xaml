<Window x:Class="SonarQuickMixer.Views.PromptTextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Name"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptLabel"
                   Text="Name"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8"/>
        <TextBox x:Name="InputBox"
                 Grid.Row="1"
                 Style="{StaticResource FluentTextBoxStyle}"
                 Margin="0,0,0,16"
                 KeyDown="InputBox_KeyDown"/>
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Style="{StaticResource FluentButtonStyle}"
                    MinWidth="88"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="Cancel_Click"/>
            <Button Content="OK"
                    Style="{StaticResource FluentAccentButtonStyle}"
                    MinWidth="88"
                    IsDefault="True"
                    Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
