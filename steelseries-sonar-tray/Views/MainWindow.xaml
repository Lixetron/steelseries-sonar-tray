<Window x:Class="SonarQuickMixer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SonarQuickMixer.Controls"
        xmlns:loc="clr-namespace:SonarQuickMixer.Localization"
        Title="{loc:Tr mixer.title}"
        Width="404"
        SizeToContent="Height"
        MinHeight="200"
        MaxHeight="700"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Visibility="Collapsed"
        ShowActivated="True"
        Deactivated="Window_Deactivated">
    <Border x:Name="OverlayRoot"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="16"
            SnapsToDevicePixels="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="ViewHeaderHost" Grid.Row="0" Margin="0,0,0,12" ClipToBounds="True">
                <Grid x:Name="MixerHeaderPanel" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="{loc:Tr mixer.title}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatusText"
                                   Text="{loc:Tr mixer.status.connecting}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   Margin="0,4,0,0"/>
                        <TextBlock x:Name="DeviceInfoText"
                                   Visibility="Collapsed"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="MidiDeviceInfoText"
                                   Visibility="Collapsed"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Top">
                        <controls:BatteryStatusIndicator x:Name="BatteryIndicator"
                                                         Visibility="Collapsed"
                                                         Margin="0,0,8,0"
                                                         VerticalAlignment="Center"
                                                         ToolTip="{loc:Tr mixer.tooltip.battery}"/>
                        <Grid Width="28"
                              Height="28"
                              VerticalAlignment="Center">
                            <Button x:Name="OpenSettingsButton"
                                    Content="&#xE713;"
                                    ToolTip="{loc:Tr mixer.tooltip.settings}"
                                    Style="{StaticResource HeaderIconButtonStyle}"
                                    Click="OpenSettingsButton_Click"/>
                            <Border x:Name="UpdateNotificationDot"
                                    Visibility="Collapsed"
                                    Width="8"
                                    Height="8"
                                    CornerRadius="4"
                                    Background="{StaticResource AccentBrush}"
                                    BorderBrush="{StaticResource SurfaceBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,1,1,0"
                                    Cursor="Hand"
                                    ToolTip="{loc:Tr mixer.tooltip.updateAvailable}"
                                    MouseLeftButtonUp="UpdateNotificationDot_Click"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <Grid x:Name="SettingsHeaderPanel"
                      Visibility="Collapsed"
                      VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BackToMixerButton"
                            Content="&#xE72B;"
                            ToolTip="{loc:Tr mixer.tooltip.backToMixer}"
                            Style="{StaticResource HeaderIconButtonStyle}"
                            VerticalAlignment="Top"
                            Click="BackToMixerButton_Click"/>
                    <TextBlock Grid.Column="1"
                               Text="{loc:Tr mixer.settings.title}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Top"
                               Margin="4,0,0,0"/>
                </Grid>
            </Grid>

            <Grid x:Name="ViewContentHost" Grid.Row="1" ClipToBounds="True">
                <ScrollViewer x:Name="MixerTabPanel"
                              Style="{StaticResource FluentScrollViewerStyle}"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalAlignment="Stretch">
                    <StackPanel x:Name="ChannelsPanel">
                    <StackPanel x:Name="DeviceSelectorsPanel" Margin="0,0,0,10">
                        <StackPanel x:Name="OutputDeviceRow" Margin="0,0,0,8">
                            <TextBlock Text="{loc:Tr mixer.output}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>
                            <ComboBox x:Name="OutputDeviceCombo"
                                      Style="{StaticResource FluentComboBoxStyle}"
                                      SelectionChanged="OutputDeviceCombo_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel x:Name="MicrophoneDeviceRow">
                            <TextBlock Text="{loc:Tr mixer.microphone}"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>
                            <ComboBox x:Name="MicrophoneDeviceCombo"
                                      Style="{StaticResource FluentComboBoxStyle}"
                                      SelectionChanged="MicrophoneDeviceCombo_SelectionChanged"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="MasterChannelSection" Margin="0,0,0,8">
                        <TextBlock Text="{loc:Tr channel.master}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="MasterMonitorMixIcon"
                                    Grid.Column="0"
                                    Style="{StaticResource MixerMonitorMixIconStyle}"
                                    Visibility="Collapsed">
                                <TextBlock Text="&#xE7F6;"
                                           Foreground="{StaticResource AccentBrush}"
                                           Style="{StaticResource MixerMixIconGlyphStyle}"/>
                            </Border>
                            <ToggleButton x:Name="MasterMonitorMuteToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource ChannelMuteToggleStyle}"
                                          Click="MuteToggle_Click"/>
                            <Slider x:Name="MasterMonitorSlider"
                                    Grid.Column="2"
                                    Style="{StaticResource FluentSliderStyle}"
                                    ValueChanged="ChannelSlider_ValueChanged"/>
                            <TextBlock x:Name="MasterMonitorValueText"
                                       Grid.Column="3"
                                       Style="{StaticResource MixerValueStyle}"/>
                        </Grid>
                        <Grid x:Name="MasterStreamRow" Margin="0,2,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="MasterStreamMixIcon"
                                    Grid.Column="0"
                                    Style="{StaticResource MixerStreamMixIconStyle}">
                                <TextBlock Text="&#xE93E;"
                                           Foreground="{StaticResource StreamAccentBrush}"
                                           Style="{StaticResource MixerMixIconGlyphStyle}"/>
                            </Border>
                            <ToggleButton x:Name="MasterStreamMuteToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource ChannelMuteToggleStyle}"
                                          Click="MuteToggle_Click"/>
                            <Slider x:Name="MasterStreamSlider"
                                    Grid.Column="2"
                                    Style="{StaticResource FluentStreamSliderStyle}"
                                    ValueChanged="ChannelSlider_ValueChanged"/>
                            <TextBlock x:Name="MasterStreamValueText"
                                       Grid.Column="3"
                                       Style="{StaticResource MixerValueStyle}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="GameChannelSection" Margin="0,0,0,8">
                        <TextBlock Text="{loc:Tr channel.game}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="GameMonitorMixToggle"
                                          Grid.Column="0"
                                          Style="{StaticResource ChannelMonitorMixToggleStyle}"
                                          IsChecked="True"
                                          Click="MixToggle_Click"
                                          Visibility="Collapsed"/>
                            <ToggleButton x:Name="GameMonitorMuteToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource ChannelMuteToggleStyle}"
                                          Click="MuteToggle_Click"/>
                            <Slider x:Name="GameMonitorSlider"
                                    Grid.Column="2"
                                    Style="{StaticResource FluentSliderStyle}"
                                    ValueChanged="ChannelSlider_ValueChanged"/>
                            <TextBlock x:Name="GameMonitorValueText"
                                       Grid.Column="3"
                                       Style="{StaticResource MixerValueStyle}"/>
                        </Grid>
                        <Grid x:Name="GameStreamRow" Margin="0,2,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="GameStreamMixToggle"
                                          Grid.Column="0"
                                          Style="{StaticResource ChannelStreamMixToggleStyle}"
                                          IsChecked="True"
                                          Click="MixToggle_Click"
                                          Visibility="Collapsed"/>
                            <ToggleButton x:Name="GameStreamMuteToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource ChannelMuteToggleStyle}"
                                          Click="MuteToggle_Click"/>
                            <Slider x:Name="GameStreamSlider"
                                    Grid.Column="2"
                                    Style="{StaticResource FluentStreamSliderStyle}"
                                    ValueChanged="ChannelSlider_ValueChanged"/>
                            <TextBlock x:Name="GameStreamValueText"
                                       Grid.Column="3"
                                       Style="{StaticResource MixerValueStyle}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="ChatChannelSection" Margin="0,0,0,8">
                        <TextBlock Text="{loc:Tr channel.chat}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="ChatMonitorMixToggle"
                                          Grid.Column="0"
                                          Style="{StaticResource ChannelMonitorMixToggleStyle}"
                                          IsChecked="True"
                                          Click="MixToggle_Click"
                                          Visibility="Collapsed"/>
                            <ToggleButton x:Name="ChatMonitorMuteToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource ChannelMuteToggleStyle}"
                                          Click="MuteToggle_Click"/>
                            <Slider x:Name="ChatMonitorSlider"
                                    Grid.Column="2"
                                    Style="{StaticResource FluentSliderStyle}"
                                    ValueChanged="ChannelSlider_ValueChanged"/>
                            <TextBlock x:Name="ChatMonitorValueText"
                                       Grid.Column="3"
                                       Style="{StaticResource MixerValueStyle}"/>
                        </Grid>
                        <Grid x:Name="ChatStreamRow" Margin="0,2,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="ChatStreamMixToggle"
                                          Grid.Column="0"
                                          Style="{StaticResource ChannelStreamMixToggleStyle}"
                                          IsChecked="True"
                                          Click="MixToggle_Click"
                                          Visibility="Collapsed"/>
                            <ToggleButton x:Name="ChatStreamMuteToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource ChannelMuteToggleStyle}"
                                          Click="MuteToggle_Click"/>
                            <Slider x:Name="ChatStreamSlider"
                                    Grid.Column="2"
                                    Style="{StaticResource FluentStreamSliderStyle}"
                                    ValueChanged="ChannelSlider_ValueChanged"/>
                            <TextBlock x:Name="ChatStreamValueText"
                                       Grid.Column="3"
                                       Style="{StaticResource MixerValueStyle}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="MediaChannelSection" Margin="0,0,0,8">
                        <TextBlock Text="{loc:Tr channel.media}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="MediaMonitorMixToggle"
                                          Grid.Column="0"
                                          Style="{StaticResource ChannelMonitorMixToggleStyle}"
                                          IsChecked="True"
                                          Click="MixToggle_Click"
                                          Visibility="Collapsed"/>
                            <ToggleButton x:Name="MediaMonitorMuteToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource ChannelMuteToggleStyle}"
                                          Click="MuteToggle_Click"/>
                            <Slider x:Name="MediaMonitorSlider"
                                    Grid.Column="2"
                                    Style="{StaticResource FluentSliderStyle}"
                                    ValueChanged="ChannelSlider_ValueChanged"/>
                            <TextBlock x:Name="MediaMonitorValueText"
                                       Grid.Column="3"
                                       Style="{StaticResource MixerValueStyle}"/>
                        </Grid>
                        <Grid x:Name="MediaStreamRow" Margin="0,2,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="MediaStreamMixToggle"
                                          Grid.Column="0"
                                          Style="{StaticResource ChannelStreamMixToggleStyle}"
                                          IsChecked="True"
                                          Click="MixToggle_Click"
                                          Visibility="Collapsed"/>
                            <ToggleButton x:Name="MediaStreamMuteToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource ChannelMuteToggleStyle}"
                                          Click="MuteToggle_Click"/>
                            <Slider x:Name="MediaStreamSlider"
                                    Grid.Column="2"
                                    Style="{StaticResource FluentStreamSliderStyle}"
                                    ValueChanged="ChannelSlider_ValueChanged"/>
                            <TextBlock x:Name="MediaStreamValueText"
                                       Grid.Column="3"
                                       Style="{StaticResource MixerValueStyle}"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="AuxChannelSection" Margin="0,0,0,4">
                        <TextBlock Text="{loc:Tr channel.aux}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="AuxMonitorMixToggle"
                                          Grid.Column="0"
                                          Style="{StaticResource ChannelMonitorMixToggleStyle}"
                                          IsChecked="True"
                                          Click="MixToggle_Click"
                                          Visibility="Collapsed"/>
                            <ToggleButton x:Name="AuxMonitorMuteToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource ChannelMuteToggleStyle}"
                                          Click="MuteToggle_Click"/>
                            <Slider x:Name="AuxMonitorSlider"
                                    Grid.Column="2"
                                    Style="{StaticResource FluentSliderStyle}"
                                    ValueChanged="ChannelSlider_ValueChanged"/>
                            <TextBlock x:Name="AuxMonitorValueText"
                                       Grid.Column="3"
                                       Style="{StaticResource MixerValueStyle}"/>
                        </Grid>
                        <Grid x:Name="AuxStreamRow" Margin="0,2,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="AuxStreamMixToggle"
                                          Grid.Column="0"
                                          Style="{StaticResource ChannelStreamMixToggleStyle}"
                                          IsChecked="True"
                                          Click="MixToggle_Click"
                                          Visibility="Collapsed"/>
                            <ToggleButton x:Name="AuxStreamMuteToggle"
                                          Grid.Column="1"
                                          Style="{StaticResource ChannelMuteToggleStyle}"
                                          Click="MuteToggle_Click"/>
                            <Slider x:Name="AuxStreamSlider"
                                    Grid.Column="2"
                                    Style="{StaticResource FluentStreamSliderStyle}"
                                    ValueChanged="ChannelSlider_ValueChanged"/>
                            <TextBlock x:Name="AuxStreamValueText"
                                       Grid.Column="3"
                                       Style="{StaticResource MixerValueStyle}"/>
                        </Grid>
                    </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsTabPanel"
                              Style="{StaticResource FluentScrollViewerStyle}"
                              Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalAlignment="Stretch">
                    <StackPanel>
                    <TextBlock Text="{loc:Tr settings.features}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10"/>
                    <CheckBox x:Name="RunAtWindowsStartupToggle"
                              Content="{loc:Tr settings.startWithWindows}"
                              Style="{StaticResource FluentToggleStyle}"
                              Margin="0,0,0,10"
                              Checked="FeatureToggle_Changed"
                              Unchecked="FeatureToggle_Changed"/>
                    <CheckBox x:Name="MediaKeysOverrideToggle"
                              Content="{loc:Tr settings.mediaKeysOverride}"
                              Style="{StaticResource FluentToggleStyle}"
                              Margin="0,0,0,6"
                              Checked="FeatureToggle_Changed"
                              Unchecked="FeatureToggle_Changed"/>
                    <StackPanel x:Name="MediaKeysOverrideChannelPanel"
                                Margin="50,0,0,10">
                        <TextBlock Text="{loc:Tr settings.targetChannel}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="11"
                                   Margin="0,0,0,6"/>
                        <ComboBox x:Name="MediaKeysOverrideChannelCombo"
                                  Style="{StaticResource FluentComboBoxStyle}"
                                  SelectionChanged="MediaKeysOverrideChannelCombo_SelectionChanged"/>
                    </StackPanel>
                    <CheckBox x:Name="VolumeOverlayToggle"
                              Content="{loc:Tr settings.volumeOverlay}"
                              Style="{StaticResource FluentToggleStyle}"
                              Margin="0,0,0,10"
                              Checked="FeatureToggle_Changed"
                              Unchecked="FeatureToggle_Changed"/>
                    <CheckBox x:Name="DiscordEchoFixToggle"
                              Content="{loc:Tr settings.discordEchoFix}"
                              Style="{StaticResource FluentToggleStyle}"
                              Margin="0,0,0,10"
                              Checked="FeatureToggle_Changed"
                              Unchecked="FeatureToggle_Changed"/>
                    <CheckBox x:Name="AudioVisualizerToggle"
                              Content="{loc:Tr settings.audioVisualizer}"
                              Style="{StaticResource FluentToggleStyle}"
                              Margin="0,0,0,10"
                              Checked="FeatureToggle_Changed"
                              Unchecked="FeatureToggle_Changed"/>
                    <CheckBox x:Name="MidiEnabledToggle"
                              Content="{loc:Tr settings.midiControl}"
                              Style="{StaticResource FluentToggleStyle}"
                              Margin="0,0,0,6"
                              Checked="FeatureToggle_Changed"
                              Unchecked="FeatureToggle_Changed"/>
                    <Button x:Name="OpenMidiSetupButton"
                            Content="{loc:Tr settings.configureMidi}"
                            Style="{StaticResource UpdateLinkButtonStyle}"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,10"
                            Click="OpenMidiSetupButton_Click"/>
                    <TextBlock Text="{loc:Tr settings.deviceSelectors}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,8,0,10"/>
                    <TextBlock Text="{loc:Tr settings.deviceSelectorsHint}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>
                    <CheckBox x:Name="ShowOutputDeviceSelectorToggle"
                              Content="{loc:Tr settings.showOutputSelector}"
                              Style="{StaticResource FluentToggleStyle}"
                              Margin="0,0,0,10"
                              Checked="FeatureToggle_Changed"
                              Unchecked="FeatureToggle_Changed"/>
                    <CheckBox x:Name="ShowMicrophoneDeviceSelectorToggle"
                              Content="{loc:Tr settings.showMicrophoneSelector}"
                              Style="{StaticResource FluentToggleStyle}"
                              Margin="0,0,0,10"
                              Checked="FeatureToggle_Changed"
                              Unchecked="FeatureToggle_Changed"/>
                    <TextBlock Text="{loc:Tr settings.deviceInfo}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,8,0,10"/>
                    <TextBlock Text="{loc:Tr settings.deviceInfoHint}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>
                    <CheckBox x:Name="ShowDeviceNameToggle"
                              Content="{loc:Tr settings.showDeviceName}"
                              Style="{StaticResource FluentToggleStyle}"
                              Margin="0,0,0,10"
                              Checked="FeatureToggle_Changed"
                              Unchecked="FeatureToggle_Changed"/>
                    <CheckBox x:Name="ShowDeviceBatteryToggle"
                              Content="{loc:Tr settings.showDeviceBattery}"
                              Style="{StaticResource FluentToggleStyle}"
                              Margin="0,0,0,10"
                              Checked="FeatureToggle_Changed"
                              Unchecked="FeatureToggle_Changed"/>
                    <CheckBox x:Name="ShowDeviceConnectionToggle"
                              Content="{loc:Tr settings.showDeviceConnection}"
                              Style="{StaticResource FluentToggleStyle}"
                              Margin="0,0,0,10"
                              Checked="FeatureToggle_Changed"
                              Unchecked="FeatureToggle_Changed"/>
                    <CheckBox x:Name="ShowMidiDeviceNameToggle"
                               Content="{loc:Tr settings.showMidiDeviceName}"
                               Style="{StaticResource FluentToggleStyle}"
                               Margin="0,0,0,10"
                               Checked="FeatureToggle_Changed"
                               Unchecked="FeatureToggle_Changed"/>
                    <TextBlock Text="{loc:Tr settings.appearance}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,8,0,10"/>
                    <TextBlock Text="{loc:Tr settings.trayIcon}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               Margin="0,0,0,6"/>
                    <ComboBox x:Name="TrayIconStyleCombo"
                              Style="{StaticResource FluentComboBoxStyle}"
                              SelectionChanged="TrayIconStyleCombo_SelectionChanged"/>
                    <TextBlock Text="{loc:Tr settings.language}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               Margin="0,8,0,6"/>
                    <ComboBox x:Name="LanguageCombo"
                              Style="{StaticResource FluentComboBoxStyle}"
                              SelectionChanged="LanguageCombo_SelectionChanged"/>
                    <TextBlock Text="{loc:Tr settings.about}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="0,16,0,10"/>
                    <TextBlock x:Name="SettingsVersionText"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="11"
                               Margin="0,0,0,8"/>
                    <Border x:Name="UpdateAvailablePanel"
                            Visibility="Collapsed"
                            Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock x:Name="UpdateAvailableText"
                                       Foreground="{StaticResource TextPrimaryBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>
                            <Button x:Name="OpenReleaseButton"
                                    Content="{loc:Tr settings.openReleasePage}"
                                    Style="{StaticResource UpdateLinkButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Click="OpenReleaseButton_Click"/>
                        </StackPanel>
                    </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
